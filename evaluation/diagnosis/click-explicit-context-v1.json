        "https://github.com/pallets/click/blob/5eb46cba463ff3e3894b58f6649c5a13f02a70b1/tests/test_shell_completion.py#L309-L316"
      ],
      "annotation": {
        "reviewer": "Codex primary agent",
        "reviewed_at": "2026-09-29T05:25:50Z",
        "status": "approved"
      }
